{
    "name": "waywake/wdt-sdk",
    "description": "旺店通旗舰版 OpenAPI.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9 || ^11.1",
        "phpunit/phpunit": "^12.0.1 || ^13.0"
    },
    "conflict": {
        "illuminate/support": "<12.0 || >=14.0",
        "laravel/framework": "<12.0 || >=14.0"
    },
    "suggest": {
        "laravel/framework": "^12.0 || ^13.0 For Laravel 12 or 13 service container, config publishing, and facade integration."
    },
    "autoload": {
        "psr-4": {
            "WayWake\\WdtSdkPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WayWake\\WdtSdkPhp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "WayWake\\WdtSdkPhp\\Laravel\\WdtServiceProvider"
            ],
            "aliases": {
                "Wdt": "WayWake\\WdtSdkPhp\\Laravel\\Facades\\Wdt"
            }
        }
    }
}
